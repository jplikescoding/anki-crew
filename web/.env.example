# Copy to .env.local for local development, and set the same four names in the
# Vercel project. No real values belong in this file or anywhere else in git.

# Who may publish. A JSON object mapping ingest token -> user id, one entry per
# person, so a leaked token can be rotated for one person without disturbing
# the others. The user id must match the "user" field in that person's
# publisher/config.json.
INGEST_TOKENS={"<token-jp>":"jp","<token-b>":"b","<token-c>":"c"}

# Who may read. A JSON object mapping read key -> user id. The key is the
# ?key=... in each person's dashboard link, and it is the only thing standing
# between the dashboard and the open internet.
READ_KEYS={"<key-jp>":"jp","<key-b>":"b","<key-c>":"c"}

# Upstash Redis. The Vercel Upstash integration sets both of these
# automatically; set them by hand only for local development.
KV_REST_API_URL=https://<your-db>.upstash.io
KV_REST_API_TOKEN=<upstash-rest-token>
